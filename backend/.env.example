# gembo backend — environment variable reference
# Copy to .env only if it does not already exist; use local/synthetic values.
# All other settings live in configs/config.yaml.

# ---------------------------------------------------------------------------
# Exchange credentials
# ---------------------------------------------------------------------------
# Private trading and private collection now read credentials from the
# exchange_credentials table (DB-only). Do not set exchange API credentials
# in .env for runtime.

# ---------------------------------------------------------------------------
# Active exchanges — overrides enabled flags in configs/config.yaml.
# Comma-separated list of exchange IDs. When set, only listed exchanges run.
# Comment out to rely on the YAML enabled flags instead.
# Public factory IDs: bybit, okx, binance, gate, htx, aster (not qualification).
# ---------------------------------------------------------------------------
# EXCHANGES=bybit,okx

# ---------------------------------------------------------------------------
# Infrastructure — override when running outside Docker
# ---------------------------------------------------------------------------
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# DATABASE_URL=postgres://gembo:gembo@localhost:5432/gembo?sslmode=disable

# ---------------------------------------------------------------------------
# App-level credential encryption (base64-encoded 32-byte key)
# Used by API/account-data-collector/position-manager for stored credentials.
# ---------------------------------------------------------------------------
# CREDENTIALS_ENCRYPTION_KEY_BASE64=

# ---------------------------------------------------------------------------
# Logging — override the config.yaml defaults
# ---------------------------------------------------------------------------
# LOG_LEVEL=info    # debug|info|warn|error
# LOG_FORMAT=json   # json|text

# ---------------------------------------------------------------------------
# Authentication — override the built-in development signing secret
# ---------------------------------------------------------------------------
# AUTH_JWT_SECRET=
# AUTH_TOKEN_TTL=24h

# See ../docs/development.md for the complete configuration inventory.
# configs/config.yaml is tracked; never put secrets in it.
