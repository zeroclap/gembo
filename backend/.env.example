# gembo backend — environment variable reference
# Copy to .env and fill in values as needed.
# All variables are optional and have sensible defaults (shown in comments).

# ---------------------------------------------------------------------------
# Config file path (default: configs/config.yaml)
# ---------------------------------------------------------------------------
# CONFIG_PATH=configs/config.yaml

# ---------------------------------------------------------------------------
# Server (api binary only)
# ---------------------------------------------------------------------------
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Redis (all binaries)
# ---------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------------------------------------------------------------------------
# PostgreSQL (api — optional, trader — required)
# Position management routes require a configured database.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://gembo:gembo@localhost:5432/gembo?sslmode=disable

# ---------------------------------------------------------------------------
# Exchanges — comma-separated list of enabled exchange IDs
# Supported: bybit, okx, binance, gate
# ---------------------------------------------------------------------------
EXCHANGES=bybit,okx

# Per-exchange credentials (pattern: <EXCHANGE_ID_UPPER>_API_KEY / _API_SECRET / _API_PASSPHRASE)
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# GATE_API_KEY=
# GATE_API_SECRET=

# ---------------------------------------------------------------------------
# Market filter (collector)
# Omit to include all values for that dimension.
# ---------------------------------------------------------------------------
MARKET_TYPES=perpetual
MARKET_QUOTE_ASSETS=USDT
MARKET_SETTLE_ASSETS=USDT

# ---------------------------------------------------------------------------
# Hooks / BullMQ (collector)
# ---------------------------------------------------------------------------
# BULLMQ_ENABLED=false
# BULLMQ_QUEUE_PREFIX=gembo

# ---------------------------------------------------------------------------
# Trader
# ---------------------------------------------------------------------------
# TRADER_LEVERAGE=1
# TRADER_MARGIN_MODE=isolated
# TRADER_MONITOR_INTERVAL=30s
# TRADER_FUNDING_CHECK_INTERVAL=5m

# ---------------------------------------------------------------------------
# Logging (all binaries)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
