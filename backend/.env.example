# gembo backend — environment variable reference
# Copy to .env and fill in real values.
# All other settings live in configs/config.yaml.

# ---------------------------------------------------------------------------
# Exchange credentials  (<ID>_API_KEY / _API_SECRET / _API_PASSPHRASE)
# ---------------------------------------------------------------------------
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# GATE_API_KEY=
# GATE_API_SECRET=

# ---------------------------------------------------------------------------
# Active exchanges — overrides enabled flags in configs/config.yaml.
# Comma-separated list of exchange IDs. When set, only listed exchanges run.
# Comment out to rely on the YAML enabled flags instead.
# Supported: bybit, okx, binance, gate
# ---------------------------------------------------------------------------
# EXCHANGES=bybit,okx

# ---------------------------------------------------------------------------
# Infrastructure — override when running outside Docker
# ---------------------------------------------------------------------------
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# DATABASE_URL=postgres://gembo:gembo@localhost:5432/gembo?sslmode=disable

# ---------------------------------------------------------------------------
# App-level credential encryption (base64-encoded 32-byte key)
# Used by API/trader when storing and reading exchange_credentials fields.
# ---------------------------------------------------------------------------
# CREDENTIALS_ENCRYPTION_KEY_BASE64=

# ---------------------------------------------------------------------------
# Logging — override the config.yaml defaults
# ---------------------------------------------------------------------------
# LOG_LEVEL=info    # debug|info|warn|error
# LOG_FORMAT=json   # json|text
